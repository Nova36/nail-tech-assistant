# --- Firebase Web SDK (public, safe to commit) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Firebase Admin (server-only) ---
# Use either FIREBASE_SERVICE_ACCOUNT_JSON (single JSON string)
# OR (FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- App config ---
ALLOWED_EMAIL=user@example.com
APP_URL=http://localhost:3000

# --- Pinterest (single-user static token) ---
PINTEREST_ACCESS_TOKEN=pina_your_long_lived_token_here
# PINTEREST_API_BASE=https://api.pinterest.com/v5
# PINTEREST_MOCK=false
